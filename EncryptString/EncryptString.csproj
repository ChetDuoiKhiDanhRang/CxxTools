<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>imgs\app.ico</ApplicationIcon>
    <AssemblyVersion>2.1</AssemblyVersion>
    <FileVersion>2.1</FileVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="imgs\copy_24.png" />
    <None Remove="imgs\icon_24.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BaseTools">
      <HintPath>..\..\CxxLibs\BaseTools\bin\Debug\netstandard2.0\BaseTools.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <!--<ItemGroup>
    <None Remove="imgs\app.ico" />
    <None Remove="imgs\LeftAr_24.png" />
    <None Remove="imgs\RightAr_24.png" />
  </ItemGroup>-->

  <ItemGroup>
    <Resource Include="imgs\copy_24.png" />
    <Resource Include="imgs\icon.png" />
    <Resource Include="imgs\icon_24.png" />
    <Resource Include="imgs\LeftAr_24.png" />
    <Resource Include="imgs\RightAr_24.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="imgs\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
